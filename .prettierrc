{
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "auto",
	"experimentalOperatorPosition": "start",
	"printWidth": 80,
	"proseWrap": "preserve",
	"quoteProps": "as-needed",
	"semi": true,
	"singleQuote": false,
	"tabWidth": 4,
	"trailingComma": "es5",

	"plugins": ["prettier-plugin-jinja-template"],
    
	"overrides": [
		{
			"files": ["*.njk"],
			"options": {
				"parser": "jinja-template"
			}
		}
	]
}
